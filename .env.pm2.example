# For Fresh Me only: copy to .env on the PM2/Nginx EC2.
# Confirm port 3103 is free. Do not change your other applications' env files.
NODE_ENV=production
PORT=3103
TRUST_PROXY=1
LOG_LEVEL=info
DEMO_PAYMENT=false

# Supabase Connect -> Session pooler. Percent-encode only the password component.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres
DATABASE_SSL=verify-full
DATABASE_POOL_MAX=10
DATABASE_MIGRATE_ON_START=true
# Optional custom database CA file; the bundled Supabase CA is used by default.
DATABASE_CA_CERT=

# Independent random values, at least 32 characters each.
JWT_SECRET=replace-with-independent-random-secret
AGENT_KEY=replace-with-another-independent-random-secret

# Real Test Mode keys first; use Live Mode keys and webhook before opening orders.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-corresponding-api-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-independent-webhook-secret

# Use the exact region and bucket name. S3 can stay private.
AWS_REGION=ap-south-1
S3_BUCKET=replace-with-your-bucket-name
S3_KEY_PREFIX=fresh-me/products
# Fill both keys for dedicated credentials, or leave both empty for an IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Set only when using temporary access-key credentials.
AWS_SESSION_TOKEN=

ADMIN_EMAIL=owner@your-domain.com
# 12+ characters, upper/lowercase, digit, symbol, eight distinct characters.
# Quote values containing # in this PM2 dotenv file.
ADMIN_PASSWORD="replace-with-a-strong-unique-value"
# Backend origin temporarily; change to exact frontend HTTPS origin later.
CLIENT_ORIGIN=https://api.your-domain.com
