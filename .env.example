NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
DATABASE_SSL=verify-full
DATABASE_POOL_MAX=10
# Production: run npm run db:migrate before starting, and leave this false.
DATABASE_MIGRATE_ON_START=false
# Optional absolute path to the root CA downloaded from Supabase database settings
DATABASE_CA_CERT=
JWT_SECRET=replace-with-at-least-32-random-characters
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
AGENT_KEY=replace-with-at-least-32-random-characters
# S3 stays private; the backend serves product images through /api/images/.
AWS_REGION=ap-south-1
S3_BUCKET=your-fresh-me-bucket
S3_KEY_PREFIX=fresh-me/products
# Fill both keys, or leave both empty to use the EC2 IAM role / AWS credential chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary AWS credentials; otherwise leave empty.
AWS_SESSION_TOKEN=
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=0
LOG_LEVEL=info
# Set DEMO_PAYMENT=true for local simulation without real Razorpay credentials (dev only)
DEMO_PAYMENT=false

# Only enable on a separate non-production test backend, never the live print queue.
AGENT_FILE_MODE_ALLOWED=false
