NODE_ENV=production
PORT=3000
# Prefer the exact Session pooler URL from Supabase Connect on IPv4-only EC2/Docker.
# Percent-encode the password: @ becomes %40. Do not quote values in this file.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_URL_ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres
DATABASE_SSL=verify-full
DATABASE_POOL_MAX=10
JWT_SECRET=replace-with-independent-random-secret
AGENT_KEY=replace-with-another-independent-random-secret
RAZORPAY_KEY_ID=rzp_live_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace-with-independent-webhook-secret
# Use the bucket's actual region. The bucket can remain private.
AWS_REGION=ap-south-1
S3_BUCKET=replace-with-your-bucket-name
S3_KEY_PREFIX=fresh-me/products
# Fill both keys, or leave both empty to use an existing permitted EC2 IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required only for temporary credentials.
AWS_SESSION_TOKEN=
ADMIN_EMAIL=owner@your-domain.com
ADMIN_PASSWORD=replace-with-unique-strong-password
CLIENT_ORIGIN=https://orders.your-domain.com
TRUST_PROXY=1
LOG_LEVEL=info
DEMO_PAYMENT=false
